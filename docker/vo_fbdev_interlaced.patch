+/* Release the old front page only after the submitted flip reaches a field.
+ * Usually that has already happened during decoding. The short bounded wait
+ * also covers fast frames and paused redraws without adding a whole field. */
+static void pf_release_page(void)
+{
+    if (!pf_pending) return;
+    int64_t deadline = av_gettime_relative() + 60000;
+    while (pf_field() == pf_submitted_field) {
+        if (av_gettime_relative() >= deadline) {
+            mp_msg(MSGT_VO, MSGL_ERR, "Interlaced page release timed out\n");
+            exit(1);
+        }
+        av_usleep(500);
+    }
+    pf_pending = 0;
+}
