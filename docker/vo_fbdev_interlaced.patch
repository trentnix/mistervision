+static int64_t pf_analog_blank(void)
+{
+    unsigned previous = pf_analog_counter();
+    int64_t sampled = av_gettime_relative();
+    int64_t deadline = sampled + 100000;
+    while (av_gettime_relative() < deadline) {
+        av_usleep(50);
+        unsigned current = pf_analog_counter();
+        int64_t now = av_gettime_relative();
+        if (current != previous) {
+            if (((current - previous) & 0xff) == 1 && now - sampled < 300)
+                return now;
+            pf_analog_retries++;
